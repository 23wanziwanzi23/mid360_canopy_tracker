<launch>
  <!--
    高级二维树冠仿真。
    和 canopy_sim.launch 相比，这个 launch 把树冠仿真节点换成
    tree_laserscan_sim_node_v2，用来测试更接近真实果园的 LaserScan：
      - 椭圆树冠
      - 不规则边界
      - 树冠缺口
      - 离群噪声点
      - 可选相邻树干扰
  -->
  <arg name="clockwise" default="true" />
  <arg name="step_distance" default="1.0" />
  <arg name="target_distance" default="0.80" />
  <arg name="linear_speed" default="0.04" />
  <arg name="max_angular_speed" default="0.22" />
  <arg name="work_pause_duration" default="1.0" />
  <arg name="roi_angle_limit_deg" default="120.0" />
  <arg name="laser_yaw_offset_deg" default="-90.0" />
  <!-- 树冠参数。target_radius_x / target_radius_y 控制椭圆长短轴。 -->
  <arg name="target_radius_x" default="0.78" />
  <arg name="target_radius_y" default="0.55" />
  <arg name="target_yaw_deg" default="20.0" />
  <arg name="target_waviness_amplitude" default="0.05" />
  <arg name="target_waviness_frequency" default="6" />
  <arg name="target_radial_noise_stddev" default="0.015" />
  <!-- 缺口参数。gap_center 是树冠局部椭圆角度，不是世界坐标角。 -->
  <arg name="target_enable_gap" default="true" />
  <arg name="target_gap_center_deg" default="120.0" />
  <arg name="target_gap_width_deg" default="45.0" />
  <!-- 相邻树干扰。先默认关闭；需要压力测试时改成 true。 -->
  <arg name="neighbor_enabled" default="false" />
  <!-- 离群点数量。初次测试建议从 0 或 5 开始，逐步增加。 -->
  <arg name="outlier_count" default="5" />
  <node pkg="mid360_processor"
        type="simple_chassis_sim_node"
        name="simple_chassis_sim_node"
        output="screen">
    <param name="init_x" value="1.7" />
    <param name="init_y" value="0.0" />
    <param name="init_yaw_deg" value="-90.0" />
    <param name="laser_yaw_offset_deg" value="$(arg laser_yaw_offset_deg)" />
    <param name="cmd_vel_topic" value="/cmd_vel" />
    <param name="odom_topic" value="/Odometry" />
    <param name="max_linear_speed" value="0.30" />
    <param name="max_angular_speed" value="0.60" />
  </node>
  <node pkg="mid360_processor"
        type="tree_laserscan_sim_node_v2"
        name="tree_laserscan_sim_node_v2"
        output="screen">
    <param name="odom_topic" value="/Odometry" />
    <param name="scan_topic" value="/scan_2d" />
    <param name="laser_frame" value="livox_frame" />
    <param name="laser_yaw_offset_deg" value="$(arg laser_yaw_offset_deg)" />
    <param name="range_max" value="4.0" />
    <param name="boundary_point_count" value="900" />
    <param name="target_enabled" value="true" />
    <param name="target_x" value="0.0" />
    <param name="target_y" value="0.0" />
    <param name="target_radius_x" value="$(arg target_radius_x)" />
    <param name="target_radius_y" value="$(arg target_radius_y)" />
    <param name="target_yaw_deg" value="$(arg target_yaw_deg)" />
    <param name="target_waviness_amplitude" value="$(arg target_waviness_amplitude)" />
    <param name="target_waviness_frequency" value="$(arg target_waviness_frequency)" />
    <param name="target_radial_noise_stddev" value="$(arg target_radial_noise_stddev)" />
    <param name="target_enable_gap" value="$(arg target_enable_gap)" />
    <param name="target_gap_center_deg" value="$(arg target_gap_center_deg)" />
    <param name="target_gap_width_deg" value="$(arg target_gap_width_deg)" />
    <param name="neighbor_enabled" value="$(arg neighbor_enabled)" />
    <param name="neighbor_x" value="-1.8" />
    <param name="neighbor_y" value="0.8" />
    <param name="neighbor_radius_x" value="0.65" />
    <param name="neighbor_radius_y" value="0.50" />
    <param name="neighbor_yaw_deg" value="-15.0" />
    <param name="neighbor_waviness_amplitude" value="0.04" />
    <param name="neighbor_waviness_frequency" value="5" />
    <param name="neighbor_radial_noise_stddev" value="0.012" />
    <param name="neighbor_enable_gap" value="false" />
    <param name="outlier_count" value="$(arg outlier_count)" />
    <param name="outlier_min_range" value="0.45" />
    <param name="outlier_max_range" value="2.4" />
    <param name="outlier_angle_min_deg" value="-70.0" />
    <param name="outlier_angle_max_deg" value="70.0" />
  </node>
  <node pkg="mid360_processor"
        type="odom_listener_5_dipan"
        name="canopy_tracker_node"
        output="screen">
    <param name="clockwise" value="$(arg clockwise)" />
    <param name="step_distance" value="$(arg step_distance)" />
    <param name="target_distance" value="$(arg target_distance)" />
    <param name="linear_speed" value="$(arg linear_speed)" />
    <param name="max_angular_speed" value="$(arg max_angular_speed)" />
    <param name="work_pause_duration" value="$(arg work_pause_duration)" />
    <param name="roi_angle_limit_deg" value="$(arg roi_angle_limit_deg)" />
    <!--
      控制节点用这个参数估计树心并累计绕树角度。
      椭圆树冠没有唯一半径，这里先用平均半径近似。
    -->
    <param name="canopy_radius_for_orbit" value="0.66" />
    <param name="laser_yaw_offset_deg" value="$(arg laser_yaw_offset_deg)" />
    <param name="cmd_vel_topic" value="/cmd_vel" />
    <param name="odom_topic" value="/Odometry" />
    <param name="scan_topic" value="/scan_2d" />
    <param name="laser_frame" value="livox_frame" />
  </node>

  <node pkg="rviz"
      type="rviz"
      name="rviz"
      args="-d $(find mid360_processor)/rviz/canopy_sim.rviz"
      output="screen" />
</launch>
