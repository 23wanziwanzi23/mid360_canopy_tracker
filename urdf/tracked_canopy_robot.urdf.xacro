<?xml version="1.0"?>
<robot name="tracked_canopy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Gazebo 中是否显示全部激光射线；只影响显示，不影响 /scan_2d。 -->
  <xacro:arg name="visualize_laser" default="false"/>
  <!--
    tracked_canopy_robot.urdf.xacro
    
    这是第一版 Gazebo 用机器人模型。
    建模策略：
      - 外观看起来像履带底盘；
      - 运动学使用 Gazebo 平面运动插件；
      - 这样你可以先验证 /cmd_vel、/Odometry、/scan_2d 和控制节点闭环；
      - 后续再升级成更复杂的履带接触物理模型。
    坐标约定：
      - base_link 的 x 轴：车体前进方向；
      - base_link 的 y 轴：车体左侧；
      - livox_frame 的 x 轴：雷达正前方；
      - 雷达安装在车体右侧，朝右看树冠，所以相对 base_link 绕 z 轴旋转 -90 度。
  -->
  <!--
    实车俯视外形约 1.60 m × 1.00 m。base_width 不含履带，左右履带
    加入后总宽度为 0.76 + 2 × 0.12 = 1.00 m。
  -->
  <xacro:property name="base_length" value="1.50"/>
  <xacro:property name="base_width" value="0.76"/>
  <xacro:property name="base_height" value="0.34"/>
  <xacro:property name="track_length" value="1.60"/>
  <xacro:property name="track_width" value="0.12"/>
  <xacro:property name="track_height" value="0.24"/>
  <xacro:property name="wheel_radius" value="0.16"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <!-- base_footprint 是地面投影坐标系，常用于导航。 -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
  </joint>
  <!-- 主车体。 -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="35.0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.4" iyz="0" izz="1.8"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.05 0.25 0.90 1.0"/>
      </material>
    </visual>
  </link>
  <!-- 左右履带是不参与地面碰撞的视觉外壳。 -->
  <link name="left_track_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${track_length} ${track_width} ${track_height}"/>
      </geometry>
      <material name="track_dark">
        <color rgba="0.03 0.03 0.03 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="left_track_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_link"/>
    <origin xyz="0 ${base_width / 2.0 + track_width / 2.0} ${-base_height / 2.0 + track_height / 2.0}" rpy="0 0 0"/>
  </joint>
  <link name="right_track_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="${track_length} ${track_width} ${track_height}"/>
      </geometry>
      <material name="track_dark"/>
    </visual>
  </link>
  <joint name="right_track_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_link"/>
    <origin xyz="0 ${-(base_width / 2.0 + track_width / 2.0)} ${-base_height / 2.0 + track_height / 2.0}" rpy="0 0 0"/>
  </joint>
  <!-- 四个车轮仅用于外形显示，固定在车体上以避免自由关节抖动。 -->
  <xacro:macro name="display_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_gray">
          <color rgba="0.20 0.20 0.20 1.0"/>
        </material>
      </visual>
    </link>
    <joint name="${prefix}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x} ${y} ${-base_height / 2.0 + wheel_radius}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:display_wheel prefix="front_left"  x="0.55"  y="${base_width / 2.0 + track_width / 2.0}"/>
  <xacro:display_wheel prefix="front_right" x="0.55"  y="${-(base_width / 2.0 + track_width / 2.0)}"/>
  <xacro:display_wheel prefix="rear_left"   x="-0.55" y="${base_width / 2.0 + track_width / 2.0}"/>
  <xacro:display_wheel prefix="rear_right"  x="-0.55" y="${-(base_width / 2.0 + track_width / 2.0)}"/>
  <!-- 雷达安装架。雷达在右侧，朝向右侧树冠。 -->
  <link name="livox_frame">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.10 0.08 0.08"/>
      </geometry>
      <material name="lidar_green">
        <color rgba="0.0 0.9 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="livox_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="0.00 -0.50 0.20" rpy="0 0 -1.57079632679"/>
  </joint>
  <!--
    机器人是平面运动学模型：所有外形都会合并到 base_footprint，
    关闭根链接重力可防止没有承重碰撞体的车辆穿过地面。
  -->
  <gazebo reference="base_footprint">
    <gravity>false</gravity>
  </gazebo>
  <!--
    这一阶段主要验证树冠跟随状态机，因此用平面运动插件精确执行
    /cmd_vel，并发布 /Odometry。这可以避免 Gazebo 轮胎摩擦参数导致的
    履带侧滑偏差；车体、履带和车轮仍按实际尺寸显示，但不参与地面碰撞。
  -->
  <gazebo>
    <plugin name="tracked_planar_drive" filename="libgazebo_ros_planar_move.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <odometryRate>50.0</odometryRate>
      <cmdTimeout>0.5</cmdTimeout>
      <commandTopic>/cmd_vel</commandTopic>
      <odometryTopic>/Odometry</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <broadcastTF>true</broadcastTF>
    </plugin>
  </gazebo>
  <!-- Gazebo 2D 激光雷达插件。输出话题是 /scan_2d，frame_id 是 livox_frame。 -->
  <gazebo reference="livox_frame">
    <sensor name="side_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>$(arg visualize_laser)</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>50.00</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan_2d</topicName>
        <frameName>livox_frame</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
